\name{beetle_sd}
\alias{beetle_sd}
\title{Compute the standard deviation of a beetle measurement}
\usage{beetle_sd(variable = c("Width", "Angle"), species = NULL)}
\arguments{\item{variable}{One of \code{"Width"} or \code{"Angle"}.}\item{species}{Optional character vector of species labels.}}
\value{A numeric scalar.}
\description{Computes the sample standard deviation of \code{Width} or \code{Angle}, optionally within one or more species.}
