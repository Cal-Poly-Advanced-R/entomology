\name{beetle_mean}
\alias{beetle_mean}
\title{Compute the mean of a beetle measurement}
\usage{beetle_mean(variable = c("Width", "Angle"), species = NULL)}
\arguments{\item{variable}{One of \code{"Width"} or \code{"Angle"}.}\item{species}{Optional character vector of species labels.}}
\value{A numeric scalar.}
\description{Computes the arithmetic mean of \code{Width} or \code{Angle}, optionally within one or more species.}
